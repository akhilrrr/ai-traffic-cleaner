{% comment %}
  AI Traffic Cleaner — Front-End Client Interceptor
{% endcomment %}

<script>
  window.AiCleanerSettings = {
    isolateChatGPT: {{ block.settings.isolate_chatgpt | json }},
    isolatePerplexity: {{ block.settings.isolate_perplexity | json }},
    isolateClaude: {{ block.settings.isolate_claude | json }},
    blockScrapers: {{ block.settings.block_scrapers | json }},
    whitelistRoute: {{ block.settings.whitelist_route | default: "/llms.txt" | json }}
  };

  (function() {
    var ua = (navigator.userAgent || "").toLowerCase();
    var settings = window.AiCleanerSettings;

    var isChatGPT = settings.isolateChatGPT && (ua.indexOf("gptbot") !== -1 || ua.indexOf("chatgpt") !== -1);
    var isPerplexity = settings.isolatePerplexity && ua.indexOf("perplexitybot") !== -1;
    var isClaude = settings.isolateClaude && (ua.indexOf("claudebot") !== -1 || ua.indexOf("anthropic") !== -1);

    if (isChatGPT || isPerplexity || isClaude) {
      if (window.location.pathname !== settings.whitelistRoute) {
        window.location.replace(settings.whitelistRoute);
      }
    }
  })();
</script>

{% schema %}
{
  "name": "AI Traffic Cleaner",
  "target": "head",
  "settings": [
    {
      "type": "checkbox",
      "id": "isolate_chatgpt",
      "label": "Isolate ChatGPT / OpenAI Crawlers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isolate_perplexity",
      "label": "Isolate Perplexity AI Crawlers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isolate_claude",
      "label": "Isolate Claude / Anthropic Crawlers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "block_scrapers",
      "label": "Block Untrusted Scrapers & Bots",
      "default": true
    },
    {
      "type": "text",
      "id": "whitelist_route",
      "label": "Whitelisted Route Path",
      "default": "/llms.txt"
    }
  ]
}
{% endschema %}