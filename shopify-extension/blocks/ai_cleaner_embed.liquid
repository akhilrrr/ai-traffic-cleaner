{% comment %}
  AI Traffic Cleaner - Front-End Embed Handler
  Appends merchant settings to window.AiCleanerSettings and intercepts AI traffic.
{% endcomment %}

<script>
  window.AiCleanerSettings = {
    isolateChatGPT: {{ block.settings.isolate_chatgpt | json }},
    isolatePerplexity: {{ block.settings.isolate_perplexity | json }},
    isolateClaude: {{ block.settings.isolate_claude | json }},
    blockUnknown: {{ block.settings.block_unknown | json }},
    whitelistRoute: {{ block.settings.whitelist_route | json | default: "/llms.txt" }}
  };

  (function() {
    var settings = window.AiCleanerSettings;
    var userAgent = (navigator.userAgent || "").toLowerCase();
    
    // Quick client-side interceptor as fallback if edge layer is not DNS-proxied
    var isChatGPT = userAgent.includes("gptbot") || userAgent.includes("chatgpt-user");
    var isPerplexity = userAgent.includes("perplexitybot");
    var isClaude = userAgent.includes("claudebot");

    var shouldRedirect = 
      (isChatGPT && settings.isolateChatGPT) ||
      (isPerplexity && settings.isolatePerplexity) ||
      (isClaude && settings.isolateClaude);

    if (shouldRedirect && window.location.pathname !== settings.whitelistRoute) {
      // Instantly swap location to raw data feed before pixels load
      window.location.replace(settings.whitelistRoute);
    }
  })();
</script>

{% schema %}
{
  "name": "AI Traffic Cleaner",
  "target": "head",
  "settings": [
    {
      "type": "header",
      "content": "Known AI Search Engines"
    },
    {
      "type": "checkbox",
      "id": "isolate_chatgpt",
      "label": "Isolate ChatGPT / OpenAI Traffic",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isolate_perplexity",
      "label": "Isolate Perplexity AI Traffic",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isolate_claude",
      "label": "Isolate Claude / Anthropic Traffic",
      "default": true
    },
    {
      "type": "header",
      "content": "Unknown Scrapers & Data Harvesters"
    },
    {
      "type": "checkbox",
      "id": "block_unknown",
      "label": "Block Unknown/Untrusted Scraping Tools",
      "default": true
    },
    {
      "type": "header",
      "content": "AI Destination Feed"
    },
    {
      "type": "text",
      "id": "whitelist_route",
      "label": "Whitelisted Route Link",
      "default": "/llms.txt",
      "info": "Path where allowed AI bots are sent to read catalog text."
    }
  ]
}
{% endschema %}