{% schema %}
{
  "name": "AI Traffic Cleaner",
  "target": "head",
  "settings": [
    {
      "type": "checkbox",
      "id": "isolate_chatgpt",
      "label": "Redirect ChatGPT to /llms.txt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "isolate_perplexity",
      "label": "Redirect Perplexity to /llms.txt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "block_scrapers",
      "label": "Block Untrusted Scrapers & Bots",
      "default": true
    },
    {
      "type": "text",
      "id": "whitelist_route",
      "label": "AI Safe Route Path",
      "default": "/llms.txt"
    }
  ]
}
{% endschema %}

<script>
  window.AiCleanerSettings = {
    isolateChatGPT: {{ block.settings.isolate_chatgpt | json }},
    isolatePerplexity: {{ block.settings.isolate_perplexity | json }},
    blockScrapers: {{ block.settings.block_scrapers | json }},
    whitelistRoute: {{ block.settings.whitelist_route | json }} || "/llms.txt"
  };

  (function() {
    var settings = window.AiCleanerSettings;
    var path = window.location.pathname;
    var ua = navigator.userAgent.toLowerCase();

    // Prevent infinite redirect loops on the safe route
    if (path === settings.whitelistRoute) return;

    // Client-side AI Bot redirection matching Edge User-Agents
    var isChatGPT = settings.isolateChatGPT && (ua.includes("gptbot") || ua.includes("chatgpt-user"));
    var isPerplexity = settings.isolatePerplexity && (ua.includes("perplexitybot") || ua.includes("perplexity"));

    if (isChatGPT || isPerplexity) {
      window.location.replace(settings.whitelistRoute);
    }
  })();
</script>